{
  "mcpServers": {
    "shadcn": {
      "command": "pnpx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "stitch": {
      "url": "https://stitch.googleapis.com/mcp",
      "type": "http",
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      }
    },
  }
}
